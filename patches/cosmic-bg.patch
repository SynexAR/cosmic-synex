From: Bruno Ernesto Russo <root@synex.ar>
Date: Sat, 5 Sep 2026 14:41:43 -0300
Subject: [PATCH] Synex: set Synex wallpaper as default background and fix
 filter_by_theme syntax

---
 data/v1/all | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/data/v1/all b/data/v1/all
index 7a5376a..179b28c 100644
--- a/data/v1/all
+++ b/data/v1/all
@@ -1,7 +1,7 @@
 (
     output: "all",
-    source: Path("/usr/share/backgrounds/cosmic/orion_nebula_nasa_heic0601a.jpg"),
-    filter_by_theme: #true,
+    source: Path("/usr/share/backgrounds/synex-2.png"),
+    filter_by_theme: true,
     rotation_frequency: 3600,
     filter_method: Lanczos,
     scaling_mode: Zoom,
-- 
