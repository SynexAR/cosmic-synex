From aa1a812e9f0c118daf671b51d56b8a7b2d281bc0 Mon Sep 17 00:00:00 2001
From: Bruno Ernesto Russo <root@synex.ar>
Date: Sun, 9 Aug 2026 16:26:43 -0300
Subject: [PATCH] Synex: add Debian packaging for cosmic-sound-theme

---
 debian/changelog     |  5 +++++
 debian/control       | 19 +++++++++++++++++++
 debian/copyright     | 18 ++++++++++++++++++
 debian/rules         |  3 +++
 debian/source/format |  1 +
 5 files changed, 46 insertions(+)
 create mode 100644 debian/changelog
 create mode 100644 debian/control
 create mode 100644 debian/copyright
 create mode 100755 debian/rules
 create mode 100644 debian/source/format

diff --git a/debian/changelog b/debian/changelog
new file mode 100644
index 0000000..f9185a2
--- /dev/null
+++ b/debian/changelog
@@ -0,0 +1,5 @@
+cosmic-sound-theme (1.5.0+synex1) stable; urgency=medium
+
+  * Initial Synex packaging of COSMIC sound theme.
+
+ -- Synex Team <root@synex.ar>  Mon, 28 Jul 2026 00:00:00 -0300
diff --git a/debian/control b/debian/control
new file mode 100644
index 0000000..2e97f64
--- /dev/null
+++ b/debian/control
@@ -0,0 +1,19 @@
+Source: cosmic-sound-theme
+Section: sound
+Priority: optional
+Maintainer: Synex Team <root@synex.ar>
+Build-Depends:
+  debhelper-compat (= 13),
+  meson,
+  ninja-build
+Standards-Version: 4.6.2
+Homepage: https://github.com/pop-os/cosmic-sound-theme
+
+Package: cosmic-sound-theme
+Architecture: all
+Depends:
+  ${misc:Depends}
+Description: COSMIC desktop sound theme
+ Sound theme for the COSMIC desktop environment, providing alert,
+ action, and notification sounds following the freedesktop sound
+ theme specification.
diff --git a/debian/copyright b/debian/copyright
new file mode 100644
index 0000000..f058ac7
--- /dev/null
+++ b/debian/copyright
@@ -0,0 +1,18 @@
+Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
+Upstream-Name: COSMIC-Sounds
+Source: https://github.com/pop-os/cosmic-sound-theme
+
+Files: *
+Copyright: System76, Inc. and COSMIC Sound Theme contributors
+License: CC-BY-SA-4.0
+
+Files: debian/*
+Copyright: 2026 Synex Team <root@synex.ar>
+License: CC-BY-SA-4.0
+
+License: CC-BY-SA-4.0
+ This work is licensed under the Creative Commons
+ Attribution-ShareAlike 4.0 International License.
+ .
+ You should have received a copy of the license along with this work.
+ If not, see <https://creativecommons.org/licenses/by-sa/4.0/>.
diff --git a/debian/rules b/debian/rules
new file mode 100755
index 0000000..8f64974
--- /dev/null
+++ b/debian/rules
@@ -0,0 +1,3 @@
+#!/usr/bin/make -f
+%:
+	dh $@ --buildsystem=meson
diff --git a/debian/source/format b/debian/source/format
new file mode 100644
index 0000000..163aaf8
--- /dev/null
+++ b/debian/source/format
@@ -0,0 +1 @@
+3.0 (quilt)
-- 
2.53.0

